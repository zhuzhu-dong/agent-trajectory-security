# Copy to `.env` and fill in your real DeepSeek key.
#   cp .env.example .env
#
# The real key is NEVER written into any trajectory or report -- only a
# sha256 fingerprint of it is recorded, so a run can be tied to a credential
# without the credential being recoverable from the artifact.
DEEPSEEK_API_KEY=sk-REPLACE_ME

# Optional overrides
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DeepSeek now defaults thinking mode on; an agent tool-loop wants cheap,
# deterministic turns. Set to "high" to include reasoning in the trajectory.
DEEPSEEK_REASONING_EFFORT=none
DEEPSEEK_TIMEOUT_S=120
DEEPSEEK_MAX_RETRIES=2

# Sanitizer vault key. Leave blank and the experiment generates one on first
# run and stores it via Windows DPAPI (user-scoped). Setting it here is
# convenient for CI and weaker on a shared machine.
SANITIZER_KEY=
